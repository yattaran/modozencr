---
import type { CollectionEntry } from 'astro:content';

interface Props {
	site: CollectionEntry<'site'>;
}

const { site } = Astro.props;
const { merchTeaser } = site.data;
---

<section id="merch" class="bg-cream py-16 lg:py-24">
	<div class="section-container">
		<div class="text-center">
			<h2 class="text-section-title">{merchTeaser.title}</h2>
			<p class="text-body-muted mt-4 max-w-xl mx-auto">{merchTeaser.subtitle}</p>
			<p class="text-subtitle mt-6 text-2xl text-sage">{merchTeaser.comingSoonLabel}</p>
		</div>
	</div>
</section>
