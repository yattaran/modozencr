---
import type { CollectionEntry } from 'astro:content';

interface MerchProduct {
	slug: string;
	name: string;
	tagline: string;
	image: string;
}

interface Props {
	product: MerchProduct;
	site: CollectionEntry<'site'>;
}

const { product, site } = Astro.props;
const { ui } = site.data;
const imageAlt = ui.merchProductAlt.replace('{name}', product.name);
---

<article class="product-card">
	<div class="product-card-image">
		<img
			src={product.image}
			alt={imageAlt}
			width="360"
			height="360"
			loading="lazy"
		/>
	</div>

	<h3 class="text-card-title mt-6 text-center">{product.name}</h3>
	<p class="text-body-muted mt-3 text-center text-sm">{product.tagline}</p>
</article>
