---
import type { CollectionEntry } from 'astro:content';

interface Props {
	site: CollectionEntry<'site'>;
}

const { site } = Astro.props;
const { kitsSection } = site.data;
---

<section id="kits" class="bg-cream py-16 lg:py-24">
	<div class="section-container">
		<div class="text-center">
			<h2 class="text-section-title">{kitsSection.title}</h2>
			{
				kitsSection.comingSoon ? (
					<p class="text-subtitle mt-6 text-2xl text-sage">{kitsSection.comingSoonLabel}</p>
				) : (
					<p class="text-body-muted mt-4 max-w-xl mx-auto">{kitsSection.subtitle}</p>
				)
			}
		</div>

	</div>
</section>
