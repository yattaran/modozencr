---
import { getRelativeLocaleUrl } from 'astro:i18n';
import type { CollectionEntry } from 'astro:content';
import { kitCtaUrl } from '../lib/cta';
import { localePathArg, resolveLocale } from '../lib/i18n';

interface Props {
	kit: CollectionEntry<'kits'>;
	site: CollectionEntry<'site'>;
}

const { kit, site } = Astro.props;
const { ui } = site.data;
const locale = resolveLocale(Astro.currentLocale);
const localePath = localePathArg(locale);
const ctaUrl = kitCtaUrl(kit, site);
const detailUrl = getRelativeLocaleUrl(localePath, `/kits/${kit.data.slug}`);
---

<article class="product-card">
	<a href={detailUrl} class="product-card-image block">
		<img
			src={kit.data.image}
			alt={kit.data.title}
			width="360"
			height="360"
			loading="lazy"
		/>
	</a>

	<h3 class="text-card-title mt-6 text-center">{kit.data.title}</h3>
	<p class="text-body-muted mt-3 line-clamp-3 min-h-[4.5rem] text-center text-sm">
		{kit.data.shortDescription}
	</p>
	<a
		href={ctaUrl}
		target="_blank"
		rel="noopener noreferrer"
		class="btn-kit mt-6"
	>
		{ui.viewKit}
	</a>
</article>
