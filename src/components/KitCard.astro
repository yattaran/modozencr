---
import type { CollectionEntry } from 'astro:content';
import { kitCtaUrl } from '../lib/cta';

interface Props {
	kit: CollectionEntry<'kits'>;
	site: CollectionEntry<'site'>;
}

const { kit, site } = Astro.props;
const ctaUrl = kitCtaUrl(kit, site);
const detailUrl = `/kits/${kit.data.slug}`;
---

<article class="flex w-[240px] shrink-0 snap-start flex-col rounded-2xl bg-white p-4 shadow-[0_2px_16px_rgba(45,45,45,0.06)] sm:w-[260px]">
	<a
		href={detailUrl}
		class="flex aspect-[5/4] items-center justify-center overflow-hidden rounded-xl bg-cream p-3"
	>
		<img
			src={kit.data.image}
			alt={kit.data.title}
			width="400"
			height="320"
			class="max-h-full max-w-full object-contain drop-shadow-sm"
			loading="lazy"
		/>
	</a>
	<h3 class="mt-4 text-center font-heading text-sm font-extrabold tracking-wide text-charcoal">
		{kit.data.title}
	</h3>
	<p class="mt-2 min-h-[2.5rem] flex-1 text-center text-xs leading-relaxed text-charcoal/75">
		{kit.data.shortDescription}
	</p>
	<a
		href={ctaUrl}
		target="_blank"
		rel="noopener noreferrer"
		class="btn-kit mt-4"
	>
		VER KIT
	</a>
</article>
