---
import { getRelativeLocaleUrl } from 'astro:i18n';
import type { CollectionEntry } from 'astro:content';
import { LOCALE_OPTIONS, localePathArg, resolveLocale, stripLocaleFromPath } from '../lib/i18n';

interface Props {
	site: CollectionEntry<'site'>;
}

const { site } = Astro.props;
const currentLocale = resolveLocale(Astro.currentLocale);
const basePath = stripLocaleFromPath(Astro.url.pathname);
const { ui } = site.data;
---

<div class="lang-switcher relative">
	<button
		type="button"
		id="lang-switcher-btn"
		class="flex h-10 w-10 items-center justify-center rounded-full text-ink transition-colors duration-300 hover:bg-cream-dark hover:text-sage"
		aria-label={ui.language}
		aria-expanded="false"
		aria-haspopup="listbox"
		aria-controls="lang-switcher-menu"
	>
		<svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
			<path
				stroke-linecap="round"
				stroke-linejoin="round"
				d="M12 21a9.004 9.004 0 008.716-6.747M12 21a9.004 9.004 0 01-8.716-6.747M12 21c2.485 0 4.5-4.03 4.5-9S14.485 3 12 3m0 18c-2.485 0-4.5-4.03-4.5-9S9.515 3 12 3m0 0a8.997 8.997 0 017.843 4.582M12 3a8.997 8.997 0 00-7.843 4.582m15.686 0A11.953 11.953 0 0112 10.5c-2.998 0-5.74-1.1-7.843-2.918m15.686 0A8.959 8.959 0 0121 12c0 .778-.099 1.533-.284 2.253m0 0A17.919 17.919 0 0112 16.5a17.92 17.92 0 01-8.716-2.247m0 0A8.966 8.966 0 013 12c0-1.264.26-2.467.732-3.553"
			></path>
		</svg>
		<span class="sr-only">{ui.language}</span>
		<span
			class="absolute -bottom-0.5 -right-0.5 rounded bg-sage px-1 py-px text-[9px] font-semibold leading-none text-cream"
			aria-hidden="true"
		>
			{LOCALE_OPTIONS.find((o) => o.locale === currentLocale)?.label}
		</span>
	</button>

	<ul
		id="lang-switcher-menu"
		role="listbox"
		class="lang-switcher-menu absolute right-0 top-full z-50 mt-2 hidden min-w-[10rem] overflow-hidden rounded-2xl border border-cream-dark bg-cream py-1 shadow-[var(--shadow-soft)]"
		aria-label={ui.language}
	>
		{
			LOCALE_OPTIONS.map(({ locale, label, title }) => {
				const href = getRelativeLocaleUrl(localePathArg(locale), basePath);
				const isActive = locale === currentLocale;
				return (
					<li role="option" aria-selected={isActive}>
						<a
							href={href}
							hreflang={locale}
							lang={locale}
							title={title}
							class:list={[
								'flex items-center justify-between gap-3 px-4 py-2.5 text-sm transition-colors duration-300',
								isActive
									? 'bg-cream-dark font-medium text-sage'
									: 'text-ink hover:bg-cream-dark hover:text-sage',
							]}
						>
							<span>{title}</span>
							<span class="text-micro text-sage">{label}</span>
						</a>
					</li>
				);
			})
		}
	</ul>
</div>

<script>
	const btn = document.getElementById('lang-switcher-btn');
	const menu = document.getElementById('lang-switcher-menu');

	const close = () => {
		menu?.classList.add('hidden');
		btn?.setAttribute('aria-expanded', 'false');
	};

	btn?.addEventListener('click', (e) => {
		e.stopPropagation();
		const isOpen = menu?.classList.toggle('hidden') === false;
		btn.setAttribute('aria-expanded', String(isOpen));
	});

	document.addEventListener('click', (e) => {
		if (!btn?.contains(e.target as Node) && !menu?.contains(e.target as Node)) {
			close();
		}
	});

	document.addEventListener('keydown', (e) => {
		if (e.key === 'Escape') close();
	});
</script>
