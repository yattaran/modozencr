---
import BenefitIcon from './BenefitIcon.astro';

interface Props {
	items: { label: string; icon: string }[];
}

const { items } = Astro.props;
---

<section class="border-t border-cream-dark bg-cream-dark/40 py-12 lg:py-16">
	<div class="section-container">
		<ul class="benefits-row">
			{
				items.map((item) => (
					<li class="flex w-[160px] flex-col items-center gap-3 text-center">
						<BenefitIcon icon={item.icon} />
						<span class="text-small font-medium text-ink/80">
							{item.label}
						</span>
					</li>
				))
			}
		</ul>
	</div>
</section>
