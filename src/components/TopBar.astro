---
import TopBarIcon from './TopBarIcon.astro';

interface Props {
	items: { label: string; icon: string }[];
}

const { items } = Astro.props;
---

<div class="bg-sage-dark text-cream">
	<div class="section-container flex h-11 items-center justify-center gap-x-8 gap-y-1 overflow-x-auto">
		{
			items.map((item) => (
				<span class="inline-flex shrink-0 items-center gap-2 whitespace-nowrap text-xs font-medium uppercase tracking-wide">
					<TopBarIcon icon={item.icon} />
					{item.label}
				</span>
			))
		}
	</div>
</div>
