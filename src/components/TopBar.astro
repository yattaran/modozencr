---
import TopBarIcon from './TopBarIcon.astro';

interface Props {
	items: { label: string; icon: string }[];
}

const { items } = Astro.props;
---

<div class="bg-sage text-white">
	<div class="section-container flex flex-wrap items-center justify-center gap-x-6 gap-y-2 py-2.5 text-[11px] font-medium sm:text-xs">
		{
			items.map((item) => (
				<span class="inline-flex items-center gap-1.5 whitespace-nowrap">
					<TopBarIcon icon={item.icon} />
					{item.label}
				</span>
			))
		}
	</div>
</div>
