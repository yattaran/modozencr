---
import type { CollectionEntry } from 'astro:content';
import BenefitIcon from './BenefitIcon.astro';

interface Props {
	site: CollectionEntry<'site'>;
}

const { site } = Astro.props;
const { brand, benefits } = site.data;
---

<section class="overflow-hidden bg-cream">
	<div class="section-container pt-10 pb-6 lg:pt-14 lg:pb-8">
		<div class="grid items-center gap-8 lg:grid-cols-2 lg:gap-12">
			<div class="order-2 text-center lg:order-1 lg:text-left">
				<h1 class="hero-title font-heading text-5xl font-black uppercase text-charcoal sm:text-6xl lg:text-[4.5rem] lg:leading-none">
					{brand.name}
				</h1>
				<p class="mt-3 text-lg font-medium text-sage sm:text-xl">{brand.tagline}</p>
				<a href="/#kits" class="btn-primary mt-8">VER KITS</a>
			</div>

			<div class="order-1 lg:order-2">
				<img
					src="/images/hero-sloth.png"
					alt="Perezoso en modo zen meditando"
					width="1024"
					height="546"
					class="mx-auto w-full max-w-xl"
					loading="eager"
					fetchpriority="high"
				/>
			</div>
		</div>
	</div>

	<div class="border-t border-cream-dark/60 bg-cream py-8">
		<div class="section-container">
			<ul class="grid grid-cols-2 gap-x-4 gap-y-6 sm:grid-cols-3 lg:grid-cols-5 lg:gap-4">
				{
					benefits.map((item) => (
						<li class="flex flex-col items-center gap-2.5 text-center">
							<BenefitIcon icon={item.icon} />
							<span class="text-[10px] font-bold leading-tight tracking-wide text-sage sm:text-xs">
								{item.label}
							</span>
						</li>
					))
				}
			</ul>
		</div>
	</div>
</section>
