---
import type { CollectionEntry } from 'astro:content';
import BenefitIcon from './BenefitIcon.astro';

interface Props {
	site: CollectionEntry<'site'>;
}

const { site } = Astro.props;
const { brand, benefits } = site.data;
const { heroCopy } = brand;
---

<section class="overflow-hidden bg-paper">
	<div class="section-container pb-8 pt-12 lg:pb-12 lg:pt-16">
		<div class="grid items-center gap-8 lg:grid-cols-[2fr_3fr] lg:gap-12">
			<div class="order-2 z-10 text-center lg:order-1 lg:text-left">
				<h1 class="text-hero">{brand.name}</h1>
				<p class="text-subtitle mt-4 text-xl text-sage lg:text-2xl">{brand.tagline}</p>
				<p class="text-body-muted mx-auto mt-4 max-w-md lg:mx-0">{heroCopy}</p>
				<a href="/#kits" class="btn-primary mt-8">Ver kits</a>
			</div>

			<div class="hero-visual order-1 lg:order-2">
				<img
					src="/images/hero-sloth.png"
					alt="Perezoso en modo zen meditando"
					width="1024"
					height="546"
					loading="eager"
					fetchpriority="high"
				/>
			</div>
		</div>
	</div>

	<div class="border-t border-cream-dark/50 py-12 lg:py-16">
		<div class="section-container">
			<ul class="benefits-row">
				{
					benefits.map((item) => (
						<li class="flex w-[140px] flex-col items-center gap-3 text-center">
							<BenefitIcon icon={item.icon} />
							<span class="text-small font-medium text-sage">
								{item.label}
							</span>
						</li>
					))
				}
			</ul>
		</div>
	</div>
</section>
