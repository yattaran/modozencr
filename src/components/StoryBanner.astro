---
import { getRelativeLocaleUrl } from 'astro:i18n';
import { localePathArg, resolveLocale } from '../lib/i18n';

interface Props {
	quote: string;
	subquote: string;
	ctaLabel: string;
	teaserSlothAlt: string;
}

const { quote, subquote, ctaLabel, teaserSlothAlt } = Astro.props;
const locale = resolveLocale(Astro.currentLocale);
const aboutHref = getRelativeLocaleUrl(localePathArg(locale), '/nosotros');
---

<section class="bg-cream py-12 lg:py-16">
	<div class="section-container">
		<div
			class="grid overflow-hidden rounded-3xl bg-[#f0e6da] shadow-[var(--shadow-soft)] lg:grid-cols-[minmax(0,44%)_1fr]"
		>
			<div
				class="relative flex min-h-[200px] items-center justify-center px-4 py-6 sm:min-h-[240px] sm:px-6 lg:min-h-[280px] lg:py-8"
			>
				<img
					src="/images/teaser-sloth.png"
					alt={teaserSlothAlt}
					width={1024}
					height={682}
					class="h-auto max-h-[220px] w-full object-contain object-center sm:max-h-[260px] lg:max-h-[300px] lg:object-left"
					loading="lazy"
					decoding="async"
				/>
			</div>

			<div
				class="flex flex-col items-start justify-center gap-4 px-6 py-8 text-left sm:gap-5 sm:px-8 lg:px-10 lg:py-10 xl:px-14"
			>
				<blockquote class="w-full max-w-md">
					<p
						class="font-display text-[22px] leading-[1.05] uppercase text-ink sm:text-[26px] lg:text-[28px] xl:text-[32px]"
					>
						{quote}
					</p>
					<p class="text-body-muted mt-2 text-sm sm:mt-3 sm:text-base">{subquote}</p>
				</blockquote>

				<a href={aboutHref} class="btn-primary shrink-0 !min-h-[44px] !px-6 !py-3 !text-sm">
					{ctaLabel}
				</a>
			</div>
		</div>
	</div>
</section>
