---
interface Props {
	quote: string;
	subquote: string;
	ctaLabel: string;
}

const { quote, subquote, ctaLabel } = Astro.props;
---

<section class="bg-cream py-16 lg:py-24">
	<div class="section-container">
		<div class="story-panel grid items-center gap-8 lg:grid-cols-[minmax(0,180px)_1fr_auto] lg:gap-12">
			<div class="mx-auto w-full max-w-[200px] lg:mx-0">
				<img
					src="/images/story-sloth.png"
					alt=""
					width={440}
					height={200}
					class="h-auto w-full object-contain"
					loading="lazy"
				/>
			</div>

			<blockquote class="text-center lg:text-left">
				<p class="font-display text-[28px] leading-[1.1] text-ink sm:text-[34px] lg:text-[40px]">
					{quote}
				</p>
				<p class="text-body-muted mt-4 text-lg">{subquote}</p>
			</blockquote>

			<a href="/nosotros" class="btn-primary mx-auto shrink-0 lg:mx-0">
				{ctaLabel}
			</a>
		</div>
	</div>
</section>
