---
interface Props {
	quote: string;
	subquote: string;
	ctaLabel: string;
}

const { quote, subquote, ctaLabel } = Astro.props;
---

<section class="bg-cream-banner py-10 lg:py-14">
	<div class="section-container">
		<div class="flex flex-col items-center gap-6 lg:flex-row lg:items-center lg:gap-8">
			<div class="w-full shrink-0 lg:w-[280px] xl:w-[320px]">
				<img
					src="/images/story-sloth.png"
					alt=""
					width={640}
					height={296}
					class="mx-auto h-auto w-full max-w-sm object-contain lg:max-w-none"
					loading="lazy"
				/>
			</div>

			<blockquote class="flex-1 text-center lg:text-left">
				<p class="font-heading text-lg font-extrabold leading-snug text-charcoal sm:text-xl lg:text-2xl">
					{quote}
				</p>
				<p class="mt-2 text-base text-charcoal/80 sm:text-lg">{subquote}</p>
			</blockquote>

			<a href="/nosotros" class="btn-sage shrink-0 whitespace-nowrap">
				{ctaLabel}
			</a>
		</div>
	</div>
</section>
