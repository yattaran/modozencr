---
interface Props {
	size?: 'sm' | 'md';
	class?: string;
}

const { size = 'md', class: className = '' } = Astro.props;
const sizeClasses = size === 'sm' ? 'h-14 w-14' : 'h-20 w-20 sm:h-24 sm:w-24';
---

<img
	src="/images/badge-su-modo-zen.png"
	alt="SU MODO ZEN"
	width={96}
	height={96}
	class:list={['object-contain', sizeClasses, className]}
	loading="lazy"
/>
