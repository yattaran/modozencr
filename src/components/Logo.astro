---
interface Props {
	class?: string;
}

const { class: className = '' } = Astro.props;
---

<a href="/" class:list={['inline-flex shrink-0 items-center', className]}>
	<img
		src="/images/logo.png"
		alt="MODO ZEN"
		width={168}
		height={64}
		class="h-10 w-auto max-w-[140px] object-contain object-left sm:h-11 sm:max-w-[160px] lg:h-12 lg:max-w-[180px]"
		loading="eager"
	/>
</a>
