---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import KitsSection from '../components/KitsSection.astro';
import MerchTeaserSection from '../components/MerchTeaserSection.astro';
import WaitlistSection from '../components/WaitlistSection.astro';
import StoryBanner from '../components/StoryBanner.astro';
import ZenchoAdvice from '../components/ZenchoAdvice.astro';
import { getSiteConfig } from '../lib/content';
import { showKitsSection, showStoryBanner } from '../lib/launch';
import { resolveLocale } from '../lib/i18n';

const locale = resolveLocale(Astro.currentLocale);
const site = await getSiteConfig(locale);
---

<BaseLayout site={site}>
	<Hero site={site} />
	<WaitlistSection site={site} />
	<MerchTeaserSection site={site} />
	{showKitsSection() && <KitsSection site={site} />}
	<ZenchoAdvice {...site.data.zenchoAdvice} slothAlt={site.data.ui.zenchoSlothAlt} />
	{showStoryBanner() && (
		<StoryBanner {...site.data.story} teaserSlothAlt={site.data.ui.teaserSlothAlt} />
	)}
</BaseLayout>
