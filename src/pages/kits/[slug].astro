---
import { getRelativeLocaleUrl } from 'astro:i18n';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { render } from 'astro:content';
import { getSiteConfig, getKits, getKitBySlug } from '../../lib/content';
import { kitCtaUrl } from '../../lib/cta';
import { launchRedirect } from '../../lib/launch';
import { LOCALES, localePathArg, resolveLocale } from '../../lib/i18n';

export async function getStaticPaths() {
	const slugs = new Set<string>();
	for (const locale of LOCALES) {
		const kits = await getKits(locale);
		for (const kit of kits) {
			slugs.add(kit.data.slug);
		}
	}
	return [...slugs].map((slug) => ({ params: { slug } }));
}

const locale = resolveLocale(Astro.currentLocale);
const hidden = launchRedirect(Astro, locale);
if (hidden) return hidden;

const slug = Astro.params.slug!;
const kit = await getKitBySlug(slug, locale);

if (!kit) {
	return Astro.redirect(getRelativeLocaleUrl(localePathArg(locale), '/'));
}

const site = await getSiteConfig(locale);
const { ui } = site.data;
const { Content } = await render(kit);
const ctaUrl = kitCtaUrl(kit, site);
---

<BaseLayout title={kit.data.title} description={kit.data.shortDescription} site={site}>
	<article class="bg-cream py-14 lg:py-20">
		<div class="section-container max-w-3xl">
			<a
				href={getRelativeLocaleUrl(localePathArg(locale), '/#kits')}
				class="text-micro text-sage transition-colors duration-300 hover:text-sage-dark"
			>
				&larr; {ui.allKits}
			</a>

			<div class="product-card-image mt-8 min-h-[280px] sm:min-h-[340px]">
				<img
					src={kit.data.image}
					alt={kit.data.title}
					width="480"
					height="480"
					class="max-h-72 w-full max-w-sm object-contain sm:max-h-80"
					style="filter: drop-shadow(0 12px 32px rgba(35, 33, 29, 0.14));"
				/>
			</div>

			<h1 class="text-section-title mt-8">{kit.data.title}</h1>
			<p class="text-subtitle mt-3 text-lg text-sage">{kit.data.shortDescription}</p>

			<div class="prose-brand mt-8">
				<Content />
			</div>

			<div class="mt-10 flex flex-col gap-4 sm:flex-row">
				<a
					href={ctaUrl}
					target="_blank"
					rel="noopener noreferrer"
					class="btn-primary text-center"
				>
					{ui.whatsappKit}
				</a>
				<a href={getRelativeLocaleUrl(localePathArg(locale), '/#kits')} class="btn-secondary-outline text-center">
					{ui.otherKits}
				</a>
			</div>
		</div>
	</article>
</BaseLayout>
