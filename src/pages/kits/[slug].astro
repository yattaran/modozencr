---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection, render } from 'astro:content';
import { getSiteConfig } from '../../lib/content';
import { kitCtaUrl } from '../../lib/cta';

export async function getStaticPaths() {
	const kits = await getCollection('kits');
	return kits.map((kit) => ({
		params: { slug: kit.data.slug },
		props: { kit },
	}));
}

const { kit } = Astro.props;
const site = await getSiteConfig();
const { Content } = await render(kit);
const ctaUrl = kitCtaUrl(kit, site);
---

<BaseLayout title={kit.data.title} description={kit.data.shortDescription} site={site}>
	<article class="bg-cream py-12 lg:py-20">
		<div class="section-container max-w-3xl">
			<a href="/#kits" class="text-sm font-semibold text-sage hover:text-sage-dark">
				&larr; Todos los kits
			</a>

			<div class="mt-8 flex min-h-[280px] items-center justify-center overflow-hidden rounded-2xl bg-cream p-6 sm:min-h-[360px] sm:p-10">
				<img
					src={kit.data.image}
					alt={kit.data.title}
					width="600"
					height="500"
					class="max-h-72 w-full max-w-md object-contain drop-shadow-md sm:max-h-80"
				/>
			</div>

			<h1 class="mt-8 font-heading text-3xl font-extrabold text-charcoal sm:text-4xl">
				{kit.data.title}
			</h1>
			<p class="mt-3 text-lg text-sage">{kit.data.shortDescription}</p>

			<div class="prose prose-neutral mt-8 max-w-none text-charcoal/90">
				<Content />
			</div>

			<div class="mt-10 flex flex-col gap-4 sm:flex-row">
				<a
					href={ctaUrl}
					target="_blank"
					rel="noopener noreferrer"
					class="btn-primary text-center"
				>
					Consultar por WhatsApp
				</a>
				<a href="/#kits" class="btn-secondary text-center">Ver otros kits</a>
			</div>
		</div>
	</article>
</BaseLayout>
