---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection, render } from 'astro:content';
import { getSiteConfig } from '../../lib/content';
import { kitCtaUrl } from '../../lib/cta';

export async function getStaticPaths() {
	const kits = await getCollection('kits');
	return kits.map((kit) => ({
		params: { slug: kit.data.slug },
		props: { kit },
	}));
}

const { kit } = Astro.props;
const site = await getSiteConfig();
const { Content } = await render(kit);
const ctaUrl = kitCtaUrl(kit, site);
---

<BaseLayout title={kit.data.title} description={kit.data.shortDescription} site={site}>
	<article class="bg-cream py-14 lg:py-20">
		<div class="section-container max-w-3xl">
			<a
				href="/#kits"
				class="text-micro text-sage transition-colors duration-300 hover:text-sage-dark"
			>
				&larr; Todos los kits
			</a>

			<div class="mt-8 flex min-h-[280px] items-center justify-center rounded-3xl bg-cream p-6 sm:min-h-[340px] sm:p-10">
				<img
					src={kit.data.image}
					alt={kit.data.title}
					width="480"
					height="480"
					class="max-h-72 w-full max-w-sm object-contain sm:max-h-80"
					style="filter: drop-shadow(0 12px 32px rgba(35, 33, 29, 0.14));"
				/>
			</div>

			<h1 class="text-section-title mt-8">{kit.data.title}</h1>
			<p class="text-subtitle mt-3 text-lg text-sage">{kit.data.shortDescription}</p>

			<div class="prose-brand mt-8">
				<Content />
			</div>

			<div class="mt-10 flex flex-col gap-4 sm:flex-row">
				<a
					href={ctaUrl}
					target="_blank"
					rel="noopener noreferrer"
					class="btn-primary text-center"
				>
					Consultar por WhatsApp
				</a>
				<a href="/#kits" class="btn-secondary-outline text-center">Ver otros kits</a>
			</div>
		</div>
	</article>
</BaseLayout>
