---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getSiteConfig } from '../../lib/content';
import { whatsappUrl } from '../../lib/cta';
import { resolveLocale } from '../../lib/i18n';
import { launchRedirect } from '../../lib/launch';

const locale = resolveLocale(Astro.currentLocale);
const hidden = launchRedirect(Astro, locale);
if (hidden) return hidden;
const site = await getSiteConfig(locale);
const { about, ui } = site.data;
const contactUrl = whatsappUrl(site);
---

<BaseLayout title={about.title} site={site}>
	<section class="bg-cream py-16 lg:py-24">
		<div class="section-container max-w-3xl">
			<h1 class="text-section-title">{about.title}</h1>
			<p class="text-subtitle mt-5 text-xl text-sage">{about.lead}</p>

			<div class="prose-brand mt-12 space-y-6">
				{
					about.paragraphs.map((paragraph) => (
						<p>{paragraph}</p>
					))
				}
			</div>

			<img
				src="/images/story-sloth.png"
				alt={ui.aboutSlothAlt}
				width="640"
				height="296"
				class="mx-auto mt-16 w-full max-w-md object-contain"
				loading="lazy"
			/>

			<div id="contacto" class="mt-16 text-center">
				<a
					href={contactUrl}
					target="_blank"
					rel="noopener noreferrer"
					class="btn-primary"
				>
					{ui.whatsappContact}
				</a>
			</div>
		</div>
	</section>
</BaseLayout>
