---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getSiteConfig } from '../lib/content';
import { whatsappUrl } from '../lib/cta';
import { resolveLocale } from '../lib/i18n';

const locale = resolveLocale(Astro.currentLocale);
const site = await getSiteConfig(locale);
const { merch } = site.data;
const contactUrl = whatsappUrl(site, merch.whatsappMessage);
---

<BaseLayout title={merch.title} site={site}>
	<section class="bg-cream py-16 lg:py-24">
		<div class="section-container max-w-3xl text-center">
			<h1 class="text-section-title">{merch.title}</h1>
			<p class="text-subtitle mt-5 text-xl text-sage">{merch.lead}</p>

			<div class="prose-brand mt-12 space-y-6 text-left">
				{
					merch.paragraphs.map((paragraph) => (
						<p>{paragraph}</p>
					))
				}
			</div>

			<a
				href={contactUrl}
				target="_blank"
				rel="noopener noreferrer"
				class="btn-primary mt-12"
			>
				{merch.ctaLabel}
			</a>
		</div>
	</section>
</BaseLayout>
