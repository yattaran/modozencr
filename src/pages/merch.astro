---
import BaseLayout from '../layouts/BaseLayout.astro';
import MerchHero from '../components/MerchHero.astro';
import MerchProductCard from '../components/MerchProductCard.astro';
import { getSiteConfig } from '../lib/content';
import { whatsappUrl } from '../lib/cta';
import { resolveLocale } from '../lib/i18n';
import { launchRedirect } from '../lib/launch';

const locale = resolveLocale(Astro.currentLocale);
const hidden = launchRedirect(Astro, locale);
if (hidden) return hidden;
const site = await getSiteConfig(locale);
const { merch } = site.data;
const contactUrl = whatsappUrl(site, merch.whatsappMessage);
---

<BaseLayout title={merch.title} site={site}>
	<MerchHero image={merch.hero.image} alt={merch.hero.alt} />

	<section class="bg-cream pb-16 lg:pb-24">
		<div class="section-container">
			<div class="products-grid max-w-5xl mx-auto">
				{
					merch.products.map((product) => (
						<MerchProductCard product={product} site={site} />
					))
				}
			</div>

			<div class="mt-16 text-center">
				<a
					href={contactUrl}
					target="_blank"
					rel="noopener noreferrer"
					class="btn-primary"
				>
					{merch.ctaLabel}
				</a>
			</div>
		</div>
	</section>
</BaseLayout>
